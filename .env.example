# claude-office 설정. `cp .env.example .env` 한 뒤 고친다. .env 는 git 에 올라가지 않는다.
# 수집기(Claude 를 쓰는 컴퓨터마다)와 허브(화면을 띄우는 컴퓨터 하나)가 같은 파일 형식을 쓴다.
# 한 컴퓨터에서 다 돌리면 기본값 그대로 두면 된다.

# ── 수집기 ─────────────────────────────────────────────
# 세션을 보낼 허브 주소. 허브가 다른 컴퓨터(서버)에 있으면 그 주소로 바꾼다. 예: http://myserver:3006
CLAUDE_OFFICE_HUB=http://127.0.0.1:3006
# 화면에 보일 이 컴퓨터 이름. 비우면 컴퓨터 호스트 이름
CLAUDE_OFFICE_HOST=
# basic: 파일 이름·Bash 설명·Claude 말 앞 80자까지 보낸다 / none: 도구 이름과 상태만
CLAUDE_OFFICE_DETAIL=basic
# ~/.claude 와 Orca 프로필 말고 더 읽을 Claude 설정 폴더(CLAUDE_CONFIG_DIR). 콜론(:)으로 구분
CLAUDE_OFFICE_ROOTS=

# ── 허브 ───────────────────────────────────────────────
# 허브를 열 주소. 127.0.0.1 = 이 컴퓨터에서만. 다른 컴퓨터가 보내게 하려면 0.0.0.0 또는 VPN(예: Tailscale) 주소
OFFICE_BIND=127.0.0.1
OFFICE_PORT=3006
# 직접 실행(uv)할 때 설정·캐릭터 이미지를 둘 폴더. 비우면 저장소의 data/ (도커는 볼륨을 쓴다)
OFFICE_DATA=

# ── 둘 다 ──────────────────────────────────────────────
# 비우면 인증 없음. 정하면 허브는 쓰기(수집기 전송·설정 저장·이미지 올리기)에 이 값을 요구하고,
# 수집기는 이 값을 보낸다. 허브를 다른 컴퓨터에 열 때는 꼭 정한다. 예: openssl rand -hex 24
OFFICE_TOKEN=
